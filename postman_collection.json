                                {
                                    "key": "page",
                                    "value": "{{page}}"
                                },
                                {
                                    "key": "limit",
                                    "value": "{{limit}}"
                                }
                            ]
                        },
                        "description": "List users with pagination helpers (total_pages, has_next, has_prev, next_page, prev_page)."
                    }
                }
            ]
