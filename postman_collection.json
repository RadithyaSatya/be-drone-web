{
    "info": {
        "name": "XFlight Backend",
        "description": "Postman collection for XFlight backend endpoints.",
        "_postman_id": "7c0cb8c2-9fb1-4d15-98a5-4e4f1c6d2a5b",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "description": "Login to obtain JWT and generate short-lived WS tokens.",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"secret123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Returns JWT token. Username can be username or email."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const data = pm.response.json();",
                                    "if (data && data.token) {",
                                    "  pm.collectionVariables.set('authToken', data.token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Generate WS Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}"
                            },
                            {
                                "key": "X-Device-Token",
                                "value": "{{deviceToken}}",
                                "disabled": true
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/ws-token",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "ws-token"
                            ]
                        },
                        "description": "Returns short-lived WS token. Use either Authorization or X-Device-Token."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const data = pm.response.json();",
                                    "if (data && data.token) {",
                                    "  pm.collectionVariables.set('wsToken', data.token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Bootstrap Default User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"key\": \"change-me\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/bootstrap/default-user",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "bootstrap",
                                "default-user"
                            ]
                        },
                        "description": "Create default user using static key. Returns 409 if already exists."
                    }
                }
            ]
        },
        {
